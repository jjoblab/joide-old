<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Le résolveur P4 télécharge les dépendances (transport HTTPS
         vérifié, ADR-031) ; le démon de build écoute sur le rebouclage
         uniquement — jamais exposé au réseau. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lot G (ADR-048) : écran d'exercice du kit Graphite, non
             exporté, aucune navigation câblée au lot G — l'entrée
             « Kit Graphite » de l'écran P8 y mène. -->
        <activity
            android:name=".ecrans.exercice.EcranExercice"
            android:label="@string/kit_graphique"
            android:exported="false" />

        <!-- Démon de build en processus séparé (§6.7, ADR-043) :
             service de premier plan, socket locale sur le rebouclage,
             store persistant sur la base système. La mort du service
             est un événement de flux pour l'UI, jamais un état
             zombie. -->
        <service
            android:name=".BuildService"
            android:process=":build"
            android:exported="false" />
    </application>
</manifest>
