<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Le résolveur P4 télécharge les dépendances (transport HTTPS
         vérifié, ADR-031) ; le démon de build écoute sur le rebouclage
         uniquement — jamais exposé au réseau. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lot H (ADR-É3/ADR-049) : MainActivity est l’accueil « Mes
             projets » ; l’écran IDE de P8 (lots A-F) vit ici, ouvert
             sur un projet déjà importé — la racine et la bannière de
             compatibilité Gradle arrivent par extras. Le lot J
             (atelier adaptatif) remplacera cet empilement. -->
        <activity
            android:name=".ecrans.ide.EcranIde"
            android:exported="false" />

        <!-- Lot I (ADR-É4/ADR-050) : l’assistant de création en trois
             étapes, non exporté, rien n’est créé avant « Créer le
             projet ». -->
        <activity
            android:name=".ecrans.creation.EcranCreation"
            android:label="@string/accueil_nouveau_projet"
            android:exported="false" />

        <!-- Démon de build en processus séparé (§6.7, ADR-043) :
             service de premier plan, socket locale sur le rebouclage,
             store persistant sur la base système. La mort du service
             est un événement de flux pour l'UI, jamais un état
             zombie. -->
        <service
            android:name=".BuildService"
            android:process=":build"
            android:exported="false" />
    </application>
</manifest>
