<?xml version="1.0" encoding="utf-8"?>
<!-- Lot L3 : le fond de la feuille basse — surface OPAQUE (pas de
     flou d'arrière-plan en vues du cadre sous API 31, §3.6), rayon
     haut 22, liseré intérieur haut 1 dp blanc 6 % (indépendant du
     mode). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/jo_surface" />
            <corners android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#0FFFFFFF" />
            <corners android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
</layer-list>
