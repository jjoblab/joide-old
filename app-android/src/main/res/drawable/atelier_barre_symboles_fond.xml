<?xml version="1.0" encoding="utf-8"?>
<!-- Lot L2 : fond de la barre de symboles — surfaceHaute, bord haut
     1 dp bord. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/jo_surface_haute" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="?attr/jo_bord" />
        </shape>
    </item>
</layer-list>
