<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot A7 (ADR-085 décision 12) — la ligne d'un MENU ANCRÉ : l'appui
  marque la surface haute (l'identité de PopupAncre.fondAppuye
  d'hier, désormais déclarée), le repos reste transparent — la carte
  du popup porte le fond.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/jo_surface_haute" />
            <corners android:radius="@dimen/jo_rayon_composant" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
