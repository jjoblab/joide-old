<?xml version="1.0" encoding="utf-8"?>
<!--
  Fond d'une puce Chip (lot A4, ADR-085 D2 — remplace le kit Puce) :
  cochée → accent à 16 % (le mélange de ChoixPuce sur la surface du
  dessous), non cochée → surface haute. L'alpha est porté par l'item,
  Graphite demeure la source des jetons (?attr, aucune littérale).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.16" android:color="?attr/jo_accent" android:state_checked="true" />
    <item android:color="?attr/jo_surface_haute" />
</selector>
