<?xml version="1.0" encoding="utf-8"?>
<!--
  Attributs de thème JoIDE (ADR-083, lot L1 de l'atelier v2). Les
  layouts n'utilisent QUE ces ?attr/jo_* — jamais une couleur codée
  en dur (franchise §0.4 du prompt v2). Posés par Theme.JoIDE.Sombre
  et Theme.JoIDE.Clair (themes.xml) depuis colors.xml, dont les
  valeurs restent égales à Graphite.java (JetonsXmlTest).
-->
<resources>
    <attr name="jo_fond" format="color" />
    <attr name="jo_surface" format="color" />
    <attr name="jo_surface_haute" format="color" />
    <attr name="jo_puits" format="color" />
    <attr name="jo_bord" format="color" />
    <attr name="jo_bord_fin" format="color" />
    <attr name="jo_texte" format="color" />
    <attr name="jo_texte2" format="color" />
    <attr name="jo_texte3" format="color" />
    <attr name="jo_accent" format="color" />
    <attr name="jo_reussite" format="color" />
    <attr name="jo_alerte" format="color" />
    <attr name="jo_erreur" format="color" />
    <attr name="jo_violet" format="color" />
    <attr name="jo_texte_sur_accent" format="color" />
    <attr name="jo_texte_sur_reussite" format="color" />
    <attr name="jo_rideau" format="color" />

    <attr name="jo_accent_tonal" format="color" />
    <attr name="jo_reussite_tonal" format="color" />
    <attr name="jo_alerte_tonal" format="color" />
    <attr name="jo_erreur_tonal" format="color" />
    <attr name="jo_violet_tonal" format="color" />
    <attr name="jo_accent_ligne" format="color" />
    <attr name="jo_pastille_ambre" format="color" />
    <attr name="jo_pastille_violet" format="color" />
    <attr name="jo_pastille_reussite" format="color" />
    <attr name="jo_pastille_accent" format="color" />

    <attr name="jo_syntaxe_mot_cle" format="color" />
    <attr name="jo_syntaxe_type" format="color" />
    <attr name="jo_syntaxe_fonction" format="color" />
    <attr name="jo_syntaxe_chaine" format="color" />
    <attr name="jo_syntaxe_nombre" format="color" />
    <attr name="jo_syntaxe_commentaire" format="color" />
    <attr name="jo_syntaxe_defaut" format="color" />

    <!-- Le kit en XML (lot L2 de l'atelier v2, ADR-083) : constructeur
         (Context, AttributeSet) obligatoire — Icone se pose depuis le
         XML, la couleur par ?attr/jo_* exclusivement. -->
    <declare-styleable name="JoIcone">
        <attr name="jo_icone_glyphe" format="enum">
            <enum name="recherche" value="0" />
            <enum name="points" value="1" />
            <enum name="chevron" value="2" />
            <enum name="retour" value="3" />
            <enum name="plus" value="4" />
            <enum name="croix" value="5" />
            <enum name="coche" value="6" />
            <enum name="triangle" value="7" />
            <enum name="dossier" value="8" />
            <enum name="terminal" value="9" />
            <enum name="rafraichir" value="10" />
            <enum name="agrandir" value="11" />
            <enum name="bulle" value="12" />
            <enum name="etoile" value="13" />
            <enum name="menu" value="14" />
            <enum name="journal" value="15" />
            <enum name="logcat" value="16" />
        </attr>
        <attr name="jo_icone_couleur" format="reference|color" />
    </declare-styleable>

    <!-- Tuile de projet (lot A2, ADR-085) : le type porté par la tuile
         des cartes — fond et glyphe suivent ChoixCarte (calculés depuis
         la palette : jamais une couleur en XML). -->
    <declare-styleable name="JoTuileProjet">
        <attr name="jo_tuile_type" format="enum">
            <enum name="projet_android" value="0" />
            <enum name="console" value="1" />
            <enum name="bibliotheque" value="2" />
            <enum name="vide" value="3" />
        </attr>
    </declare-styleable>
</resources>
