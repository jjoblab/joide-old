<?xml version="1.0" encoding="utf-8"?>
<!--
  Styles Graphite (ADR-085, décision 7) : TextAppearance.Jo.* héritent de
  TextAppearance.Material3.* et portent l'échelle typographique de
  Graphite par @dimen (jamais de littéral — ThemesM3Test vérifie l'égalité
  avec Graphite.java) ; ShapeAppearance.Jo.* portent les rayons. Les
  styles Widget.Jo.* (boutons, cartes, champs…) arrivent avec les
  composants des lots A2+.

  Nuance documentée : la graisse 600 de Graphite (SousTitre, Titre) se
  rapproche par la famille « sans-serif-medium » (500) — la seule
  pondérée du cadre ; GraphiteVue.typographie reste la voie exacte (600
  par Typeface.Builder) pour les textes qui l'exigent.
-->
<resources>

    <!-- Échelle typographique Graphite → slots M3 -->
    <style name="TextAppearance.Jo.Legende" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/jo_texte_legende</item>
        <item name="android:lineHeight">@dimen/jo_texte_legende_interligne</item>
    </style>

    <style name="TextAppearance.Jo.Note" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/jo_texte_note</item>
        <item name="android:lineHeight">@dimen/jo_texte_note_interligne</item>
    </style>

    <style name="TextAppearance.Jo.Corps" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/jo_texte_corps</item>
        <item name="android:lineHeight">@dimen/jo_texte_corps_interligne</item>
    </style>

    <style name="TextAppearance.Jo.SousTitre" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/jo_texte_sous_titre</item>
        <item name="android:lineHeight">@dimen/jo_texte_sous_titre_interligne</item>
    </style>

    <style name="TextAppearance.Jo.Titre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/jo_texte_titre</item>
        <item name="android:lineHeight">@dimen/jo_texte_titre_interligne</item>
    </style>

    <style name="TextAppearance.Jo.TitreEcran" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/jo_texte_titre_ecran</item>
        <item name="android:lineHeight">@dimen/jo_texte_titre_ecran_interligne</item>
    </style>

    <style name="TextAppearance.Jo.Code" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/jo_texte_code</item>
        <item name="android:lineHeight">@dimen/jo_texte_code_interligne</item>
    </style>

    <style name="TextAppearance.Jo.CodeCompact" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/jo_texte_code_compact</item>
        <item name="android:lineHeight">@dimen/jo_texte_code_compact_interligne</item>
    </style>

    <!-- Rayons Graphite → slots de forme M3 -->
    <style name="ShapeAppearance.Jo.Composant" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/jo_rayon_composant</item>
    </style>

    <style name="ShapeAppearance.Jo.Carte" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/jo_rayon_carte</item>
    </style>

    <style name="ShapeAppearance.Jo.Pilule" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">@dimen/jo_rayon_puce</item>
    </style>

    <!-- Boutons Graphite (ADR-085 D2, lot A2) : hauteur 52, retrait
         horizontal 24, corps 15/22, rayon 12 (thème) — les couleurs
         suivent ChoixBouton (PRIMAIRE accent/texte-sur-accent, TONAL
         surface-haute/texte : M3 ne sait pas dire « surface haute »
         en tonal, l'habillage le dit pour lui). -->
    <style name="Widget.Jo.Button.Primaire" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.Jo.Corps</item>
        <item name="android:minHeight">@dimen/jo_bouton_hauteur</item>
        <item name="android:paddingLeft">@dimen/jo_bouton_retrait</item>
        <item name="android:paddingRight">@dimen/jo_bouton_retrait</item>
        <item name="android:textColor">?attr/jo_texte_sur_accent</item>
        <item name="backgroundTint">?attr/jo_accent</item>
    </style>

    <style name="Widget.Jo.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAppearance">@style/TextAppearance.Jo.Corps</item>
        <item name="android:minHeight">@dimen/jo_bouton_hauteur</item>
        <item name="android:paddingLeft">@dimen/jo_bouton_retrait</item>
        <item name="android:paddingRight">@dimen/jo_bouton_retrait</item>
        <item name="android:textColor">?attr/jo_texte</item>
        <item name="backgroundTint">?attr/jo_surface_haute</item>
    </style>

    <style name="Widget.Jo.Button.Texte" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.Jo.Corps</item>
        <item name="android:minHeight">@dimen/jo_bouton_hauteur</item>
        <item name="android:paddingLeft">@dimen/jo_bouton_retrait</item>
        <item name="android:paddingRight">@dimen/jo_bouton_retrait</item>
        <item name="android:textColor">?attr/jo_accent</item>
    </style>

    <!-- Champ Graphite (ADR-085 D2, lot A2) : le kit Champ est un fond
         surface, liseré bord-fin 1 dp, rayon 12, hint estompé, texte
         corps — TextInputLayout OutlinedBox habillé aux mêmes jetons
         (ChoixChamp en reste la source). -->
    <style name="Widget.Jo.Champ" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">?attr/jo_surface</item>
        <item name="boxStrokeColor">?attr/jo_bord_fin</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/jo_rayon_composant</item>
        <item name="boxCornerRadiusTopEnd">@dimen/jo_rayon_composant</item>
        <item name="boxCornerRadiusBottomStart">@dimen/jo_rayon_composant</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/jo_rayon_composant</item>
    </style>

    <!-- Nom de section des Paramètres (lot A3) : la légende Graphite
         (12/16) en graisse 700, MAJUSCULES espacées de 0,07 — le
         .nom-sect de la maquette parametres.html. -->
    <style name="TextAppearance.Jo.NomSection" parent="TextAppearance.Jo.Legende">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.07</item>
    </style>

    <!-- Titre de la barre des Paramètres (lot A3) : 20/26 gras — le
         .titre de la sous-barre de la maquette (1 px = 1 dp, 1 px = 1 sp). -->
    <style name="TextAppearance.Jo.TitreBarre" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/jo_texte_titre_barre</item>
        <item name="android:lineHeight">@dimen/jo_texte_titre_barre_interligne</item>
    </style>

    <!-- Bascule des Paramètres (lot A3, D2) : remplace le kit Segment —
         case pilule SANS liseré propre (le conteneur
         MaterialButtonToggleGroup porte fond surface haute + liseré
         bord-fin, drawable fond_bascule), texte légende 12, case cochée
         = accent 18 % + texte accent (ChoixSegment demeure la source).
         La graisse 700 de la case cochée ne s'exprime pas en
         ColorStateList : l'écran la pose (setTypeface au choix). -->
    <style name="Widget.Jo.Bascule" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.Jo.Legende</item>
        <item name="android:textColor">@color/bascule_texte</item>
        <item name="android:backgroundTint">@color/bascule_fond</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">@dimen/jo_min_bascule</item>
        <item name="android:paddingLeft">@dimen/jo_pad_bascule_cote</item>
        <item name="android:paddingRight">@dimen/jo_pad_bascule_cote</item>
        <item name="android:paddingTop">@dimen/jo_pad_bascule_haut</item>
        <item name="android:paddingBottom">@dimen/jo_pad_bascule_haut</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Jo.Pilule</item>
    </style>

    <!-- Commutateur des Paramètres (lot A3, D2) : remplace le kit
         Interrupteur — MaterialSwitch teinté aux couleurs du kit : piste
         surface haute / réussite 25 %, pouce texte3 / réussite, liseré de
         piste (trackDecoration) bord / réussite 60 %. Les teintes vivent
         en res/color (ColorStateList par ?attr, alpha porté). -->
    <style name="Widget.Jo.Interrupteur" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/interrupteur_pouce</item>
        <item name="trackTint">@color/interrupteur_piste</item>
        <item name="trackDecorationTint">@color/interrupteur_lisere</item>
    </style>

    <!-- Étiquette de champ (lot A4, maquette creation-projet.html
         .etiq : 12 px texte2 graisse 600, au-dessus de la boîte) : la
         graisse 600 de Graphite se rapproche par sans-serif-medium —
         même nuance documentée que l'échelle (GraphiteVue.typographie
         reste la voie exacte, décision 7). -->
    <style name="TextAppearance.Jo.Etiquette" parent="TextAppearance.Jo.Legende">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Numéro d'étape de l'assistant (lot A4, .etape .num) : 11/16
         gras dans un rond de 20 dp — la couleur et le rond suivent
         l'état (faite/active/à venir) par sélecteurs. -->
    <style name="TextAppearance.Jo.NumEtape" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/jo_texte_num_etape</item>
        <item name="android:lineHeight">@dimen/jo_texte_num_etape_interligne</item>
    </style>

    <!-- Puce Chip (lot A4, D2) : remplace le kit Puce — case pilule
         note 13/18, paddings 14/7 et écart 6 du kit ; cochée = accent
         16 % + texte accent + bord accent 45 % (ChoixPuce demeure la
         source, teintes en res/color par ?attr/jo_*). Le coche Material
         est MASQUÉ : la maquette ne le montre pas, la couleur porte la
         sélection ; la graisse 600 de la case cochée se pose au choix
         (même concession que la bascule A3). -->
    <style name="Widget.Jo.Puce" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.Jo.Note</item>
        <item name="android:textColor">@color/puce_texte</item>
        <item name="chipBackgroundColor">@color/puce_fond</item>
        <item name="chipStrokeColor">@color/puce_bord</item>
        <item name="chipStrokeWidth">@dimen/jo_ligne</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">0dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="chipEndPadding">0dp</item>
        <item name="android:paddingLeft">@dimen/jo_pad_puce_cote</item>
        <item name="android:paddingRight">@dimen/jo_pad_puce_cote</item>
        <item name="android:paddingTop">@dimen/jo_pad_puce_haut</item>
        <item name="android:paddingBottom">@dimen/jo_pad_puce_haut</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Jo.Pilule</item>
    </style>
</resources>
