<?xml version="1.0" encoding="utf-8"?>
<!--
  Jetons Graphite — palette SOBRE (ADR-083, lot L1 de l'atelier v2).
  Graphite.java reste la source de vérité : JetonsXmlTest vérifie
  l'égalité de chaque valeur. Les layouts ne lisent JAMAIS ces
  couleurs directement — ils passent par ?attr/jo_* (themes.xml).
  Tonaux : couleur à 12 % (14 % pour erreur/alerte) sur la surface.
-->
