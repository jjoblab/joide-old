<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot C5 — le SÉLECTEUR DE MODÈLES au dessin de référence : la GRANDE
  CARTE CENTRÉE (rayon 24, conteneur tonal haut, liseré bord-fin) —
  le titre « Choisir un modèle » et sa fermeture 30 dp ; la note de
  clé du fournisseur pointé sous le titre (le tap ouvre les réglages
  IA) ; la RECHERCHE en pilule (loupe 16 dp, l'indice porte le compte,
  la croix qui vide) ; la rangée des FOURNISSEURS puis la rangée des
  FILTRES (le fournisseur d'identifiant en menu déroulant, le tri
  nom/fournisseur, les gratuits seulement) ; la liste (favoris,
  récents, tous — remplie d'item_entete_section et d'item_modele par
  code, la liste défile DEDANS au-delà de 460 dp) ; le modèle
  personnalisé reste atteignable au pied. Aucune décision ici.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/carte_dialogue_ia"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/agent_modele_titre"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/jo_texte" />

        <jo.joide.app.android.ui.Icone
            android:id="@+id/btn_fermer_modeles"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:jo_icone_glyphe="croix"
            app:jo_icone_couleur="?attr/jo_texte2"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/action_annuler" />
    </LinearLayout>

    <!-- la note de clé du fournisseur pointé : le tap ouvre les
         réglages IA (la teinte se pose au bind) -->
    <TextView
        android:id="@+id/note_cles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="?attr/jo_texte2"
        android:clickable="true"
        android:focusable="true" />

    <!-- la recherche en pilule : loupe, l'indice au compte, la croix
         qui vide -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/pilule_recherche_ia"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <jo.joide.app.android.ui.Icone
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            app:jo_icone_glyphe="recherche"
            app:jo_icone_couleur="?attr/jo_texte2"
            android:importantForAccessibility="no" />

        <EditText
            android:id="@+id/recherche_modeles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/agent_modeles_recherche"
            android:textColor="?attr/jo_texte"
            android:textColorHint="?attr/jo_texte2"
            android:textSize="15sp"
            android:inputType="text"
            android:maxLines="1"
            android:importantForAutofill="no"
            android:importantForAccessibility="no" />

        <jo.joide.app.android.ui.Icone
            android:id="@+id/effacer_modeles"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            app:jo_icone_glyphe="croix"
            app:jo_icone_couleur="?attr/jo_texte2"
            android:contentDescription="@string/action_annuler" />
    </LinearLayout>

    <!-- la rangée des fournisseurs (les puces se posent par code :
         elles portent l'état pointé) -->
    <HorizontalScrollView
        android:id="@+id/defile_fournisseurs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/rangee_fournisseurs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- la rangée des filtres : le fournisseur d'identifiant (menu
         déroulant avec compte), le tri, les gratuits seulement -->
    <HorizontalScrollView
        android:id="@+id/filtres_modeles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/rangee_filtres_modeles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <jo.joide.app.android.ui.Puce
                android:id="@+id/filtre_fournisseur_modeles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <jo.joide.app.android.ui.Puce
                android:id="@+id/filtre_tri_modeles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <jo.joide.app.android.ui.Puce
                android:id="@+id/filtre_gratuits_modeles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- la liste : elle défile DEDANS au-delà de 460 dp (la borne se
         pose par code) -->
    <ScrollView
        android:id="@+id/defile_modeles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/liste_modeles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- l'état vide de la recherche -->
            <TextView
                android:id="@+id/vide_modeles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="13sp"
                android:textColor="?attr/jo_texte2"
                android:visibility="gone" />

            <!-- le modèle hors catalogue reste atteignable : le geste
                 personnalisé garde son popup (nom, URL de base) -->
            <TextView
                android:id="@+id/personnalise_modeles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/agent_modeles_personnalise"
                android:textSize="15sp"
                android:textColor="?attr/jo_accent"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
