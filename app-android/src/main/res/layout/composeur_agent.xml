<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot L5 — le composeur migré : rangée de pièces (puces retirables,
  masquée quand vide), saisie 14 sp dans la pilule discrète, bouton
  envoyer ; la rangée d'arrêt (■ Arrêter le tour) reste masquée tant
  qu'aucun tour ne vit. Les glyphes et auditeurs se posent par code.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/rangee_pieces_agent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <jo.joide.app.android.ui.Icone
            android:id="@+id/btn_ajouter_piece"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true" />

        <EditText
            android:id="@+id/saisie_agent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/agent_composeur_fond"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:hint="@string/agent_ecrire_indice"
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:importantForAutofill="no" />

        <jo.joide.app.android.ui.Bouton
            android:id="@+id/btn_envoyer_agent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/agent_envoyer" />
    </LinearLayout>

    <jo.joide.app.android.ui.Bouton
        android:id="@+id/btn_arreter_agent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/agent_arreter_tour"
        android:visibility="gone" />
</LinearLayout>
