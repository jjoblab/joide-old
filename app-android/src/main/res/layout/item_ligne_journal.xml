<?xml version="1.0" encoding="utf-8"?>
<!--
  Atelier v2, lot L3 (ADR-083) — une ligne du Journal (§3.6) :
  HH:MM:SS (texte3) + étiquette de source (accent ; MCP en alerte si
  échec — couleur posée par code) + message ; mono 12/19.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/heure_journal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="?attr/jo_texte3"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/source_journal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/jo_accent"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/message_journal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:textSize="12sp"
        android:lineHeight="19sp"
        android:textColor="?attr/jo_texte2"
        android:fontFamily="monospace" />
</LinearLayout>
