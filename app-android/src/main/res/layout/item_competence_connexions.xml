<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot C6 — UNE COMPÉTENCE au dessin de référence : le nom, la pilule
  de portée, l\'interrupteur, la description dessous (3 lignes
  bornées) — gonflé par binding depuis les Connexions.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/carte_serveur_connexions"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/nom_competence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Jo.Corps"
            android:textStyle="bold"
            android:textColor="?attr/jo_texte" />

        <TextView
            android:id="@+id/portee_competence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/pilule_portee"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textAppearance="@style/TextAppearance.Jo.Legende"
            android:textColor="?attr/jo_sur_contenant_secondaire" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/interrupteur_competence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/description_competence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Jo.Corps"
        android:textColor="?attr/jo_texte2" />
</LinearLayout>
