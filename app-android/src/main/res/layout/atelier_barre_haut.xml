<?xml version="1.0" encoding="utf-8"?>
<!--
  Atelier v2, lot L2 (ADR-083) — la barre supérieure (§3.1) : 52 dp,
  padding 0 10, espacement 8. ☰ ouvre le tiroir fichiers ; au centre
  l'identité (nom du projet 16/20 semi-gras, dessous la puce « n
  modules » et la pilule d'index) ; le bouton agent (fond accent 12 %,
  glyphe accent) porte le point d'activité 8 dp réussite ; ⋮ ouvre le
  menu (le retour accueil y vit désormais). Les couleurs ne viennent
  QUE des ?attr/jo_* (franchise §0.4).
  Lot A9 (ADR-085) : la racine est un <merge> — BarreHaut EST le
  LinearLayout horizontal (orientation, gravité, retrait 10 dp), un
  conteneur de moins par zone (I3).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <jo.joide.app.android.ui.Icone
        android:id="@+id/btn_tiroir_fichiers"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:jo_icone_glyphe="menu"
        app:jo_icone_couleur="?attr/jo_texte2"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/atelier_desc_fichiers" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nom_projet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/jo_texte"
            android:textSize="16sp"
            android:lineHeight="20sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <jo.joide.app.android.ui.Puce
                android:id="@+id/puce_modules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <jo.joide.app.android.ui.Pilule
                android:id="@+id/pilule_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/cadre_bouton_agent"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bouton_agent_fond"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/agent_titre">

        <jo.joide.app.android.ui.Icone
            android:id="@+id/bouton_agent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:jo_icone_glyphe="bulle"
            app:jo_icone_couleur="?attr/jo_accent" />

        <View
            android:id="@+id/point_agent"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/dot_agent"
            android:visibility="gone" />
    </FrameLayout>

    <jo.joide.app.android.ui.Icone
        android:id="@+id/bouton_options"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        app:jo_icone_glyphe="points"
        app:jo_icone_couleur="?attr/jo_texte2"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/atelier_desc_menu" />
</merge>
