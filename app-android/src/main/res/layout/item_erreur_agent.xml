<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot L5 (carte ERREUR), complétée au lot A7 (ADR-085) : voile erreur
  7 %, bord erreur 40 %, rayon 12 (le fond et le bord se posent au
  bind — GradientDrawable d'hier) ; TITRE, DÉTAIL et ACTION
  actionnable (un verbe par genre, CLE_MANQUANTE → réglages,
  MODELE_INCONNU → sélecteur) — plus aucune vue instanciée en code.
  Rapport du 2026-11-21 : la raison PAR GENRE gagne le titre muet, et
  la rangée basse porte les DEUX petits verbes de secours —
  RÉESSAYER (le dernier message utilisateur repart) et COPIER (le
  diagnostic complet part au presse-papiers).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="11dp"
    android:paddingEnd="11dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/titre_erreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Jo.Corps"
        android:textColor="?attr/jo_erreur" />

    <TextView
        android:id="@+id/detail_erreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/jo_pad_ligne_tonale"
        android:layout_marginBottom="@dimen/jo_pad_ligne_tonale"
        android:textAppearance="@style/TextAppearance.Jo.Legende"
        android:textColor="?attr/jo_texte2" />

    <TextView
        android:id="@+id/action_erreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/jo_hauteur_cible"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.Jo.Corps"
        android:textColor="?attr/jo_accent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/reessayer_erreur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/jo_hauteur_cible"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:textAppearance="@style/TextAppearance.Jo.Corps"
            android:textColor="?attr/jo_accent" />

        <TextView
            android:id="@+id/copier_erreur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/jo_hauteur_cible"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:textAppearance="@style/TextAppearance.Jo.Corps"
            android:textColor="?attr/jo_texte2" />
    </LinearLayout>
</LinearLayout>
