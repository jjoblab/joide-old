<?xml version="1.0" encoding="utf-8"?>
<!--
  Rangée SEGMENT (lot A3, Genre.SEGMENT — .rangée-envers de la
  maquette) : libellé + MaterialButtonToggleGroup en bascules pilules
  (Widget.Jo.Bascule) sur conteneur surface haute liseré bord-fin
  (fond_bascule), puis légende de franchise, puis séparateur de carte
  (1 dp, bord-fin) que l'écran masque sous la dernière rangée vivante.
  Remplace le kit Segment (ADR-085 D2) ; la graisse de la case cochée
  se pose par l'écran.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/jo_pad_rangee_envers">

        <TextView
            android:id="@+id/libelle_param"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Jo.Corps"
            android:textColor="?attr/jo_texte" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/segment_param"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/fond_bascule"
            android:padding="@dimen/jo_pad_bascule"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_segment_0"
                style="@style/Widget.Jo.Bascule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/jo_ecart_bascule" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_segment_1"
                style="@style/Widget.Jo.Bascule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/jo_ecart_bascule" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_segment_2"
                style="@style/Widget.Jo.Bascule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <TextView
        android:id="@+id/legende_param"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/jo_ecart_legende_param"
        android:layout_marginBottom="@dimen/jo_pad_rangee_envers"
        android:textAppearance="@style/TextAppearance.Jo.Legende"
        android:textColor="?attr/jo_texte3" />

    <View
        android:id="@+id/separateur_param"
        android:layout_width="match_parent"
        android:layout_height="@dimen/jo_ligne"
        android:background="?attr/jo_bord_fin" />
</LinearLayout>
