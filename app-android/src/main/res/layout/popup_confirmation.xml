<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot A7 (ADR-085 décision 12, gabarit CENTRÉ AVEC VOILE) — LA
  CONFIRMATION : ce qui exige une réponse. Titre sous-titre demi-gras,
  message au corps (les retraits du Dialogue d'hier : 24 de côté, 20
  en tête), Annuler tonal / Valider plein (la maquette agent.html :
  .btn-refuser surface haute, .btn-appliquer plein — le langage des
  popups remplace les boutons texte-accent des dialogues du cadre
  d'hier, interdits par D3). Le voile
  (?attr/jo_rideau sur le layout racine de l'écran) et la fermeture au
  retour vivent dans PopupCentre ; le ScrollView borne la hauteur
  (PopupCentre borne la fenêtre à l'écran).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="ifContentScrolls">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/jo_surface"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:strokeWidth="@dimen/jo_ligne"
        app:strokeColor="?attr/jo_bord_fin"
        app:shapeAppearance="@style/ShapeAppearance.Jo.Carte">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/jo_pad_popup_cote"
            android:paddingRight="@dimen/jo_pad_popup_cote"
            android:paddingTop="@dimen/jo_pad_popup_haut"
            android:paddingBottom="@dimen/jo_ecart_popup_boutons">

            <TextView
                android:id="@+id/titre_confirmation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Jo.SousTitre"
                android:textColor="?attr/jo_texte" />

            <TextView
                android:id="@+id/message_confirmation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jo_ecart_popup_message"
                android:textAppearance="@style/TextAppearance.Jo.Corps"
                android:textColor="?attr/jo_texte2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jo_ecart_popup_boutons"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/annuler_confirmation"
                    style="@style/Widget.Jo.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/valider_confirmation"
                    style="@style/Widget.Jo.Button.Primaire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/jo_ecart_popup_boutons" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
