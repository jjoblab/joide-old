<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot A7 (ADR-085 décision 12, gabarit CENTRÉ AVEC VOILE) — LA
  CONFIRMATION DESTRUCTIVE à deux actions distinctes (lot H, ADR-É3) :
  retirer de la liste (les fichiers restent) et effacer du stockage
  (les fichiers disparaissent) sont DEUX actions, deux libellés —
  l'annulation reste toujours disponible. Les libellés d'hier sont
  longs : les trois boutons se placent en COLONNE pleine largeur (une
  rangée ne tient pas trois cibles ≥ 48 dp à ces libellés — écart de
  gabarit documenté au rapport, l'ordre d'hier est conservé : Annuler
  en tête, Retirer, puis Effacer en action pleine).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="ifContentScrolls">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/jo_surface"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:strokeWidth="@dimen/jo_ligne"
        app:strokeColor="?attr/jo_bord_fin"
        app:shapeAppearance="@style/ShapeAppearance.Jo.Carte">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/jo_pad_popup_cote"
            android:paddingRight="@dimen/jo_pad_popup_cote"
            android:paddingTop="@dimen/jo_pad_popup_haut"
            android:paddingBottom="@dimen/jo_ecart_popup_boutons">

            <TextView
                android:id="@+id/titre_destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Jo.SousTitre"
                android:textColor="?attr/jo_texte" />

            <TextView
                android:id="@+id/message_destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jo_ecart_popup_message"
                android:textAppearance="@style/TextAppearance.Jo.Corps"
                android:textColor="?attr/jo_texte2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/annuler_destructive"
                style="@style/Widget.Jo.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jo_ecart_popup_boutons" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retirer_destructive"
                style="@style/Widget.Jo.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jo_ecart_popup_boutons" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/effacer_destructive"
                style="@style/Widget.Jo.Button.Primaire"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jo_ecart_popup_boutons" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
