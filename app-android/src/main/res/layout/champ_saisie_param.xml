<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot A3, repris au lot A7 (ADR-085 décision 12) — LE CHAMP DE SAISIE
  DES POPUPS : clé d'API, modèle IA, URL de base, nom de fichier ou de
  projet — l'EditText gonflé par binding, inclus par popup_saisie.
  Champ nu du cadre (l'état d'hier : sans habillage Graphite), police
  et hint posés au bind (la clé est monospace ; le hint dit le cas —
  clé, modèle, URL ou nom — d'où un hint hors XML que le lint ne voit
  pas). Hors autofill : ce champ porte des clés d'API, jamais un mot
  de passe d'identité à remplir.
-->
<EditText xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/edition_saisie"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAutofill="no"
    android:imeOptions="actionDone"
    android:inputType="text" />
