<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot C5 — la LIGNE D'UN MODÈLE au dessin de référence : le NOM NU
  15 sp demi-gras, la PUCE « Gratuit » (conteneur réussite) quand
  l'identifiant finit en :free, l'IDENTIFIANT NU dessous 12 sp quand
  il diffère du nom montré, la COCHE du modèle courant, l'ÉTOILE du
  favori (pleine accent / contour bord). La ligne prend le rayon 14
  et le pressed du sélecteur ; la sélection pose le conteneur
  secondaire par code. Le tap choisit ; l'étoile bascule.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ligne_modele"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/ligne_modele">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/nom_modele"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textColor="?attr/jo_texte"
                android:singleLine="true"
                android:ellipsize="end"
                android:importantForAccessibility="no" />

            <jo.joide.app.android.ui.Puce
                android:id="@+id/gratuit_modele"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:visibility="gone"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <TextView
            android:id="@+id/id_modele"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/jo_texte2"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <jo.joide.app.android.ui.Icone
        android:id="@+id/coche_modele"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        app:jo_icone_glyphe="coche"
        app:jo_icone_couleur="?attr/jo_texte"
        android:importantForAccessibility="no" />

    <jo.joide.app.android.ui.Icone
        android:id="@+id/etoile_modele"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:clickable="true"
        android:focusable="true"
        app:jo_icone_glyphe="etoile_creuse"
        app:jo_icone_couleur="?attr/jo_bord"
        android:contentDescription="@string/agent_modeles_favori" />
</LinearLayout>
