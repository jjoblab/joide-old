<?xml version="1.0" encoding="utf-8"?>
<!--
  Écran texte en dialogue des Paramètres (lot A3 : licences et NOTICE,
  journal de diagnostic — « jamais un texte coupé », ADR-É8) : vue
  défilante + texte mono compact aux couleurs du code d'hier
  (typographie CODE_COMPACT, texte secondaire, marges 20/10/20/20).
  Gonflé par binding, passé au Dialogue.saisieTexte d'hier (lot A7).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/texte_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/jo_pad_texte_page"
        android:paddingTop="@dimen/jo_pad_texte_page_haut"
        android:paddingRight="@dimen/jo_pad_texte_page"
        android:paddingBottom="@dimen/jo_pad_texte_page"
        android:textAppearance="@style/TextAppearance.Jo.CodeCompact"
        android:textColor="?attr/jo_texte2" />
</ScrollView>
