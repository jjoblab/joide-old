<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot C6 (gabarit CENTRÉ AVEC VOILE) — LES CONNEXIONS au dessin de
  référence : l\'intro honnête, la tête de section SERVEURS MCP avec
  son action « Ajouter un serveur », les cartes de serveurs (le
  projet garde son geste d\'approbation ADR-063 — un dépôt cloné
  n\'est pas un choix), la tête de section COMPÉTENCES avec son
  action « Nouvelle compétence », les dossiers des compétences.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="ifContentScrolls">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/jo_surface"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:strokeWidth="@dimen/jo_ligne"
        app:strokeColor="?attr/jo_bord_fin"
        app:shapeAppearance="@style/ShapeAppearance.Jo.Carte">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/jo_pad_popup">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/titre_connexions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/jo_pad_ligne_tonale"
                    android:paddingEnd="@dimen/jo_pad_ligne_tonale"
                    android:textAppearance="@style/TextAppearance.Jo.SousTitre"
                    android:textColor="?attr/jo_texte" />

                <jo.joide.app.android.ui.Icone
                    android:id="@+id/fermer_connexions"
                    android:layout_width="@dimen/jo_hauteur_cible"
                    android:layout_height="@dimen/jo_hauteur_cible"
                    app:jo_icone_glyphe="croix"
                    app:jo_icone_couleur="?attr/jo_texte2"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/action_annuler" />
            </LinearLayout>

            <TextView
                android:id="@+id/intro_connexions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/jo_pad_ligne_popup"
                android:paddingBottom="@dimen/jo_pad_ligne_popup"
                android:text="@string/agent_connexions_intro"
                android:textAppearance="@style/TextAppearance.Jo.Corps"
                android:textColor="?attr/jo_texte2" />

            <TextView
                android:id="@+id/avertissement_connexions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/jo_ecart_ligne_popup"
                android:paddingBottom="@dimen/jo_ecart_ligne_popup"
                android:textAppearance="@style/TextAppearance.Jo.Legende"
                android:textColor="?attr/jo_texte2" />

            <TextView
                android:id="@+id/action_connexions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/jo_hauteur_cible"
                android:gravity="center_vertical"
                android:paddingBottom="@dimen/jo_pad_ligne_popup"
                android:textAppearance="@style/TextAppearance.Jo.Corps"
                android:textStyle="bold"
                android:textColor="?attr/jo_accent" />

            <TextView
                android:id="@+id/compte_outils_connexions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/jo_pad_ligne_tonale"
                android:textAppearance="@style/TextAppearance.Jo.Legende"
                android:textColor="?attr/jo_texte3"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="@dimen/jo_pad_ligne_tonale">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/agent_connexions_serveurs"
                    android:textAppearance="@style/TextAppearance.Jo.SousTitre"
                    android:textColor="?attr/jo_texte" />

                <TextView
                    android:id="@+id/action_ajouter_serveur_connexions"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/jo_hauteur_cible"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/pilule_action_texte"
                    android:text="@string/agent_connexions_ajouter_serveur"
                    android:textAppearance="@style/TextAppearance.Jo.Corps"
                    android:textStyle="bold"
                    android:textColor="?attr/jo_accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/vide_serveurs_connexions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/jo_pad_ligne_popup"
                android:paddingBottom="@dimen/jo_pad_ligne_popup"
                android:textAppearance="@style/TextAppearance.Jo.Corps"
                android:textColor="?attr/jo_texte3" />

            <LinearLayout
                android:id="@+id/serveurs_connexions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="@dimen/jo_pad_ligne_tonale">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/agent_connexions_competences"
                    android:textAppearance="@style/TextAppearance.Jo.SousTitre"
                    android:textColor="?attr/jo_texte" />

                <TextView
                    android:id="@+id/action_nouvelle_competence_connexions"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/jo_hauteur_cible"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/pilule_action_texte"
                    android:text="@string/agent_connexions_nouvelle_competence"
                    android:textAppearance="@style/TextAppearance.Jo.Corps"
                    android:textStyle="bold"
                    android:textColor="?attr/jo_accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/vide_competences_connexions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/jo_pad_ligne_popup"
                android:paddingBottom="@dimen/jo_pad_ligne_popup"
                android:textAppearance="@style/TextAppearance.Jo.Corps"
                android:textColor="?attr/jo_texte3" />

            <LinearLayout
                android:id="@+id/competences_connexions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/dossiers_competences_connexions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/jo_pad_ligne_tonale"
                android:textAppearance="@style/TextAppearance.Jo.Legende"
                android:textColor="?attr/jo_texte2"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
