<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot C4 (2026-11-20, demande du terrain : la section thinking
  identique à CodeAssist) — LE BLOC DE TRAVAIL d'un tour : tout ce qui
  précède la dernière carte d'outil (outils, raisonnements, lignes
  tonales) se replie en UNE rangée — point d'état agrégé, « N outils ·
  M fichiers », le dernier appel replié, chevron. Déplié : le rail
  vertical (1 dp) porte les étapes dans l'ordre (la réflexion ouverte
  tant qu'elle vit, chaque appel d'outil pliable). Le point d'état et
  les libellés se posent au bind (couleur par ligne, décision 8) ;
  l'état de pli vit dans EtatAgentChat (clé = id d'appel du dernier
  outil, survit aux évictions). Le chevron vit en XML (glyphe +
  couleur, une seule voie de thémage).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bloc_travail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/entete_travail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/jo_pad_ligne_menu"
        android:paddingEnd="@dimen/jo_pad_ligne_menu"
        android:paddingTop="@dimen/jo_ecart_ligne_menu"
        android:paddingBottom="@dimen/jo_ecart_ligne_menu"
        android:background="@drawable/ligne_menu">

        <View
            android:id="@+id/point_travail"
            android:layout_width="8dp"
            android:layout_height="8dp" />

        <TextView
            android:id="@+id/resume_travail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/jo_texte"
            android:singleLine="true" />

        <TextView
            android:id="@+id/dernier_travail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/jo_ecart_entete"
            android:textSize="12sp"
            android:textColor="?attr/jo_texte3"
            android:singleLine="true"
            android:ellipsize="end" />

        <jo.joide.app.android.ui.Icone
            android:id="@+id/chevron_travail"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:jo_icone_glyphe="chevron"
            app:jo_icone_couleur="?attr/jo_texte2"
            android:contentDescription="@string/agent_travail_deplier" />
    </LinearLayout>

    <!-- les étapes dépliées : le RAIL (1 dp) à gauche, la colonne des
         étapes à droite — les vues des étapes vivent dans leurs
         propres layouts (item_raisonnement, item_outil, ligne
         tonale), gonflées par binding, jamais posées à la main -->
    <LinearLayout
        android:id="@+id/etapes_travail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/jo_pad_ligne_menu"
        android:paddingEnd="@dimen/jo_pad_ligne_menu"
        android:paddingBottom="@dimen/jo_ecart_ligne_menu"
        android:visibility="gone">

        <View
            android:id="@+id/rail_travail"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/jo_bord_fin" />

        <LinearLayout
            android:id="@+id/colonne_etapes_travail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/jo_ecart_entete_interieur"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
