<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot A7 (ADR-085 décision 12, gabarit CENTRÉ AVEC VOILE) —
  L'INFORMATION : titre, message portant un détail nommé (version de
  l'application, cause d'un échec d'import — jamais un texte générique
  qui cache, lots H/M), une action fermante unique. Même carte que la
  confirmation (surface, liseré bord-fin, rayon carte) ; le voile et
  la fermeture au retour vivent dans PopupCentre.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="ifContentScrolls">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/jo_surface"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:strokeWidth="@dimen/jo_ligne"
        app:strokeColor="?attr/jo_bord_fin"
        app:shapeAppearance="@style/ShapeAppearance.Jo.Carte">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/jo_pad_popup_cote"
            android:paddingRight="@dimen/jo_pad_popup_cote"
            android:paddingTop="@dimen/jo_pad_popup_haut"
            android:paddingBottom="@dimen/jo_ecart_popup_boutons">

            <TextView
                android:id="@+id/titre_information"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Jo.SousTitre"
                android:textColor="?attr/jo_texte" />

            <TextView
                android:id="@+id/message_information"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jo_ecart_popup_message"
                android:textAppearance="@style/TextAppearance.Jo.Corps"
                android:textColor="?attr/jo_texte2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ok_information"
                style="@style/Widget.Jo.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/jo_ecart_popup_boutons" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
