<?xml version="1.0" encoding="utf-8"?>
<!-- Rangée d'actions de l'accueil (ADR-085, lot A2) : créer au premier
     plan (primaire), importer en action secondaire (tonal) — les
     Widget.Jo.Button portent l'habillage Graphite du bouton du kit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/jo_ecart_accueil"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_nouveau"
        style="@style/Widget.Jo.Button.Primaire"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/accueil_nouveau_projet" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_importer"
        style="@style/Widget.Jo.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/jo_ecart_actions"
        android:text="@string/accueil_importer" />
</LinearLayout>
