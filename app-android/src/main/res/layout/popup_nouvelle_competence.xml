<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot C6 — LA NOUVELLE COMPÉTENCE au dessin de référence (gabarit
  centré avec voile) : le nom, la portée en pilules, l\'erreur
  honnête, Annuler et Créer. Le dossier naît avec son SKILL.md.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="ifContentScrolls">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/jo_surface"
        app:cardElevation="0dp"
        app:strokeWidth="@dimen/jo_ligne"
        app:strokeColor="?attr/jo_bord_fin"
        app:shapeAppearance="@style/ShapeAppearance.Jo.Carte">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/jo_pad_popup">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/jo_pad_ligne_tonale"
                    android:paddingEnd="@dimen/jo_pad_ligne_tonale"
                    android:text="@string/agent_connexions_nouvelle_competence"
                    android:textAppearance="@style/TextAppearance.Jo.SousTitre"
                    android:textColor="?attr/jo_texte" />

                <jo.joide.app.android.ui.Icone
                    android:id="@+id/fermer_nouvelle_competence"
                    android:layout_width="@dimen/jo_hauteur_cible"
                    android:layout_height="@dimen/jo_hauteur_cible"
                    app:jo_icone_glyphe="croix"
                    app:jo_icone_couleur="?attr/jo_texte2"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/action_annuler" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/jo_pad_ligne_popup"
                android:text="@string/agent_connexions_nom_competence"
                android:textAppearance="@style/TextAppearance.Jo.Legende"
                android:textColor="?attr/jo_texte2" />

            <EditText
                android:id="@+id/champ_nom_competence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="10dp"
                android:background="@drawable/champ_editeur_serveur"
                android:inputType="text"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Jo.Corps"
                android:textColor="?attr/jo_texte" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/jo_ecart_ligne_popup"
                android:text="@string/agent_connexions_champ_ou"
                android:textAppearance="@style/TextAppearance.Jo.Legende"
                android:textColor="?attr/jo_texte2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/portee_app_competence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/pilule_action_texte"
                    android:text="@string/agent_connexions_portee_app"
                    android:textAppearance="@style/TextAppearance.Jo.Corps"
                    android:textStyle="bold"
                    android:textColor="?attr/jo_accent" />

                <TextView
                    android:id="@+id/portee_projet_competence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/pilule_action_texte"
                    android:text="@string/agent_connexions_portee_projet"
                    android:textAppearance="@style/TextAppearance.Jo.Corps"
                    android:textStyle="bold"
                    android:textColor="?attr/jo_accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/erreur_nouvelle_competence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/jo_pad_ligne_popup"
                android:textAppearance="@style/TextAppearance.Jo.Corps"
                android:textColor="?attr/jo_erreur"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:paddingTop="@dimen/jo_pad_ligne_popup">

                <TextView
                    android:id="@+id/annuler_nouvelle_competence"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/jo_hauteur_cible"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/pilule_action_texte"
                    android:text="@string/action_annuler"
                    android:textAppearance="@style/TextAppearance.Jo.Corps"
                    android:textStyle="bold"
                    android:textColor="?attr/jo_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/creer_competence"
                    style="@style/Widget.Jo.Button.Primaire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/agent_connexions_creer" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
