<?xml version="1.0" encoding="utf-8"?>
<!--
  Atelier v2, lot L3 (ADR-083) — la feuille basse (§3.6) : la poignée
  (20 dp de zone tactile), l'en-tête unique (52 dp, rail + zone
  vivante), le corps (barre d'outils de la section puis contenu —
  aucun chiffre ni statut répété entre l'en-tête et la barre
  d'outils). Les détentes et la section active portent dans
  EtatFeuille (pur) ; la vue ne décide rien.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feuille_basse"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="vertical"
    android:background="@drawable/feuille_fond"
    android:elevation="10dp">

    <FrameLayout
        android:id="@+id/poignee_feuille"
        android:layout_width="match_parent"
        android:layout_height="20dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/grab_poignee" />
    </FrameLayout>

    <include
        android:id="@+id/entete"
        layout="@layout/feuille_entete" />

    <!-- le corps : visible en mi-hauteur et plein, caché à la barre -->
    <ScrollView
        android:id="@+id/corps_feuille"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <!-- barre d'outils de la section (§3.6 : sous l'en-tête,
                 puis le contenu — jamais de doublon d'en-tête) -->
            <LinearLayout
                android:id="@+id/outils_feuille"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

            <!-- le contenu de la section active (la vue de section se
                 pose par code : VueConsole existant, listes de
                 problèmes, journal, logcat) -->
            <FrameLayout
                android:id="@+id/contenu_feuille"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
