<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot C5 — la réponse de l'agent au dessin de référence : texte 15/22
  SANS bulle ; le CARET 7×14 dp qui clignote pendant l'écriture ; le
  pied porte le bouton COPIER (la coche revient 1,5 s) et la légende
  des jetons (« 940 in · 8.4k out » — l'usage du tour).
  Terrain du 2026-11-22 : la réponse vit en BLOCS Markdown (RenduMarkdown)
  — paragraphes, titres, listes, citations, blocs de code monospace —
  le conteneur reçoit les vues, la vue ne décide rien de la découpe.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/blocs_reponse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- le caret de frappe : 7×14 dp au rayon 2, la couleur pulse
         tant que le tour écrit (la teinte se pose par code) -->
    <View
        android:id="@+id/caret_reponse"
        android:layout_width="7dp"
        android:layout_height="14dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/caret_agent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pied_reponse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <jo.joide.app.android.ui.Icone
            android:id="@+id/copier_reponse"
            android:layout_width="26dp"
            android:layout_height="26dp"
            app:jo_icone_glyphe="copier"
            app:jo_icone_couleur="?attr/jo_texte2"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/agent_copier" />

        <TextView
            android:id="@+id/usage_reponse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11sp"
            android:textColor="?attr/jo_texte2"
            android:singleLine="true"
            android:ellipsize="end"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
