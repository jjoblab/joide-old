<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot C6 — LES FOURNISSEURS IA au dessin de référence (gabarit
  centré avec voile) : le titre, le sous-titre honnête, puis UNE
  CARTE PAR FOURNISSEUR (le point radio, le nom, la puce Connecté
  quand une clé existe ; la carte choisie ouvre le champ de clé et,
  pour la passerelle libre, l\'URL) — tout se sauvegarde à mesure.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="ifContentScrolls">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/jo_surface"
        app:cardElevation="0dp"
        app:strokeWidth="@dimen/jo_ligne"
        app:strokeColor="?attr/jo_bord_fin"
        app:shapeAppearance="@style/ShapeAppearance.Jo.Carte">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/jo_pad_popup">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/jo_pad_ligne_tonale"
                    android:paddingEnd="@dimen/jo_pad_ligne_tonale"
                    android:text="@string/agent_fournisseurs_titre"
                    android:textAppearance="@style/TextAppearance.Jo.SousTitre"
                    android:textColor="?attr/jo_texte" />

                <jo.joide.app.android.ui.Icone
                    android:id="@+id/fermer_fournisseurs"
                    android:layout_width="@dimen/jo_hauteur_cible"
                    android:layout_height="@dimen/jo_hauteur_cible"
                    app:jo_icone_glyphe="croix"
                    app:jo_icone_couleur="?attr/jo_texte2"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/action_annuler" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/jo_pad_ligne_popup"
                android:paddingBottom="@dimen/jo_pad_ligne_popup"
                android:text="@string/agent_fournisseurs_sous_titre"
                android:textAppearance="@style/TextAppearance.Jo.Corps"
                android:textColor="?attr/jo_texte2" />

            <LinearLayout
                android:id="@+id/fournisseurs_ia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
