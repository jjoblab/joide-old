<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot L5 (§3.9) — le tiroir agent : 340 dp poussé depuis la droite,
  fond surface, bord gauche 1 dp bord. En-tête (« Agent » 16
  semi-gras, puce modèle accent tonal ▾ → PopupModeles, puce mode
  neutre *Demander/Auto/Plan*, historique ⟲, ✕) ; transcript
  (padding 12) ; ligne d'activité (point 8 dp accent pulsant + pas +
  écoulé) ; ligne d'usage mono 11,5 ; le composeur (include).
  Les états vivent dans EtatAgentChat — la vue ne décide rien.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/jo_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/agent_titre"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/jo_texte" />

        <jo.joide.app.android.ui.Puce
            android:id="@+id/puce_modele_agent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <jo.joide.app.android.ui.Puce
            android:id="@+id/puce_mode_agent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp" />

        <jo.joide.app.android.ui.Icone
            android:id="@+id/btn_historique_agent"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            app:jo_icone_glyphe="rafraichir"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/agent_historique" />

        <jo.joide.app.android.ui.Icone
            android:id="@+id/btn_fermer_agent"
            android:layout_width="34dp"
            android:layout_height="34dp"
            app:jo_icone_glyphe="croix"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/action_fermer" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/jo_bord_fin" />

    <ScrollView
        android:id="@+id/defilement_agent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/colonne_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp">

        <View
            android:id="@+id/point_activite_agent"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_agent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/libelle_activite_agent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="12.5sp"
            android:textColor="?attr/jo_texte2"
            android:singleLine="true" />

        <TextView
            android:id="@+id/ecoule_activite_agent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/jo_texte3"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/ligne_usage_agent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:textSize="11.5sp"
        android:textColor="?attr/jo_texte3"
        android:fontFamily="monospace"
        android:singleLine="true" />

    <include
        android:id="@+id/composeur"
        layout="@layout/composeur_agent" />
</LinearLayout>
