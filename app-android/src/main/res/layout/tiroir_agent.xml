<?xml version="1.0" encoding="utf-8"?>
<!--
  Lot L5 — le tiroir agent migré du code vers le XML + ViewBinding.
  Structure : en-tête (titre, puce modèle → sélecteur, puce de mode,
  menu ⋯, ✕), transcript, ligne d'activité (au-dessus du composeur,
  §3.9), composeur. Les états vivent dans EtatAgentChat — la vue ne
  décide rien. Lot A9 : les glyphes et couleurs des icônes se posent
  ici (app:jo_icone_*, une seule voie de thémage).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="2dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/agent_titre"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/jo_texte" />

        <jo.joide.app.android.ui.Puce
            android:id="@+id/puce_modele_agent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp" />

        <jo.joide.app.android.ui.Puce
            android:id="@+id/puce_mode_agent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp" />

        <jo.joide.app.android.ui.Icone
            android:id="@+id/btn_menu_agent"
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:jo_icone_glyphe="points"
            app:jo_icone_couleur="?attr/jo_texte"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/agent_menu" />

        <jo.joide.app.android.ui.Icone
            android:id="@+id/btn_fermer_agent"
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:jo_icone_glyphe="croix"
            app:jo_icone_couleur="?attr/jo_texte"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/agent_fermer" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/defilement_agent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/colonne_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/ligne_activite_agent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:visibility="gone">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_agent" />

        <TextView
            android:id="@+id/libelle_activite_agent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="?attr/jo_texte"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/ecoule_activite_agent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/jo_texte3" />
    </LinearLayout>

    <!-- Lot C4 (2026-11-20, la manière CodeAssist du bandeau de
         limite) : la bande d'avertissement d'usage au-dessus du
         composeur — visible seulement quand la fenêtre qui porte le
         modèle courant est chargée (≥ 80 %), le tap ouvre l'écran
         Usages ; l'état et la teinte (alerte, erreur) se posent par
         code depuis le service, la mini-bande suit la fraction -->
    <LinearLayout
        android:id="@+id/avertissement_usage_agent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/jo_pad_ligne_tonale"
        android:paddingEnd="@dimen/jo_pad_ligne_tonale"
        android:paddingTop="@dimen/jo_ecart_ligne_menu"
        android:paddingBottom="@dimen/jo_ecart_ligne_menu"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <jo.joide.app.android.ui.Icone
                android:id="@+id/icone_avertissement_agent"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="@dimen/jo_ecart_entete"
                app:jo_icone_glyphe="triangle"
                app:jo_icone_couleur="?attr/jo_texte"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/libelle_avertissement_agent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/jo_texte"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/relance_avertissement_agent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/jo_texte2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/jo_pad_progression"
            android:orientation="horizontal"
            android:background="@drawable/piste_bande_usage">

            <View
                android:id="@+id/remplissage_avertissement_agent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/remplissage_bande_usage" />

            <View
                android:id="@+id/reste_avertissement_agent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/composeur"
        layout="@layout/composeur_agent" />
</LinearLayout>
